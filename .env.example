# Postgres — NE PAS préfixer VITE_ (sinon la chaîne irait dans le navigateur).
# Copier vers .env.local (gitignoré).
#
# Production / démo hébergée : URL Neon (protocole Postgres standard, pas le driver HTTP).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/hublify?sslmode=require
#
# CI et reproduction locale : docker compose up -d
# Si 5432 est déjà pris : POSTGRES_PUBLISH=55432 docker compose up -d
DATABASE_URL=postgresql://hublify:hublify@127.0.0.1:5432/hublify

# Better Auth — secret >= 32 caractères, unique par environnement.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Mot de passe des comptes démo (seed).
DEMO_AUTH_PASSWORD=Hublify-Demo-2026!

# Mail (optionnel). Sans clé, les messages sont capturés en base (mails_sortants).
# RESEND_API_KEY=
# MAIL_FROM=Hublify <noreply@hublify.app>

# Affiche le panneau d'aide de la page de connexion (comptes + mot de passe en clair).
# Actif automatiquement en développement. Ne JAMAIS mettre à 1 pour un client réel.
VITE_MODE_DEMO=0
