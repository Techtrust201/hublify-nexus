# Postgres — NE PAS préfixer VITE_ (sinon la chaîne irait dans le navigateur).
# Copier vers .env.local (gitignoré).
#
# Production / démo hébergée : URL Neon (protocole Postgres standard, pas le driver HTTP).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/hublify?sslmode=require
#
# CI et reproduction locale : docker compose up -d
# Si 5432 est déjà pris : POSTGRES_PUBLISH=55432 docker compose up -d
DATABASE_URL=postgresql://hublify:hublify@127.0.0.1:5432/hublify

# Better Auth — secret >= 32 caractères, unique par environnement.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Mot de passe des comptes créés par le seed, et utilisé par les tests. Sans
# valeur, le seed s'arrête plutôt que de fabriquer des comptes dont le mot de
# passe serait celui, public, d'un fichier d'exemple.
DEMO_AUTH_PASSWORD=

# Chiffrement au repos des codes d'accès des lieux (boîte à clés, alarme, Wi-Fi).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sans cette clé, l'application refuse d'enregistrer une fiche d'accès plutôt que
# de la stocker en clair. Perdre la clé rend les codes déjà chiffrés illisibles.
APP_CRYPTO_KEY=

# Mail (optionnel). Sans clé, les messages sont capturés en base (mails_sortants).
# RESEND_API_KEY=
# MAIL_FROM=Hublify <noreply@hublify.app>

# Panneau d'aide de la page de connexion : liste les comptes de recette et
# pré-remplit le formulaire. Masqué sauf demande explicite — ce panneau publie
# des identifiants à tout visiteur, il n'a rien à faire sur un environnement
# accessible depuis Internet.
# VITE_MODE_DEMO=1

# Mot de passe affiché et pré-rempli par ce panneau. Préfixe VITE_ : la valeur
# part dans le navigateur. À laisser vide partout sauf en développement local.
VITE_MDP_DEMO=
